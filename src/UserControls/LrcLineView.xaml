<UserControl x:Class="QBLyricEditor.UserControls.LrcLineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="305"
             d:DesignWidth="600"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ListView Name="LrcLinePanel"
                  Margin="0"
                  x:FieldModifier="public"
                  BorderThickness="1,1,1,0"
                  FontSize="16"
                  SelectionMode="Extended"
                  MouseDoubleClick="LrcLinePanel_MouseDoubleClick"
                  KeyUp="LrcLinePanel_KeyUp"
                  PreviewMouseLeftButtonDown="LrcLinePanel_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="LrcLinePanel_PreviewMouseMove"
                  DragOver="LrcLinePanel_DragOver"
                  DragLeave="LrcLinePanel_DragLeave"
                  Drop="LrcLinePanel_Drop"
                  FontFamily="{StaticResource LyricFont}"
                  SelectionChanged="LrcLinePanel_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Center" Text="{Binding LrcTimeText}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   Text="|"
                                   Foreground="#ddd" />
                        <TextBlock Name="LrcTextBlock" Grid.Column="2" Text="{Binding LrcText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

            <!-- 拖拽插入位置指示线 -->
            <Border Name="DragInsertIndicator"
                    Height="2"
                    Background="#26A0DA"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- 下方编辑栏 -->
        <DockPanel Grid.Row="1">
            <DockPanel.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontFamily" Value="{StaticResource LyricFont}" />
                </Style>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="22" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="#DDD" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </DockPanel.Resources>
            <Button Name="TimeDecreaseButton"
                    DockPanel.Dock="Left"
                    Click="TimeAdjustButton_Click"
                    Content="−"
                    ToolTip="减少时间" />
            <Button Name="TimeIncreaseButton"
                    DockPanel.Dock="Left"
                    Click="TimeAdjustButton_Click"
                    Content="+"
                    ToolTip="增加时间" />
            <TextBox Name="CurrentTimeText"
                     Width="93"
                     Padding="7,0,0,0"
                     HorizontalContentAlignment="Left"
                     DockPanel.Dock="Left"
                     GotFocus="CurrentTimeText_GotFocus"
                     TextChanged="CurrentTime_Changed"
                     MouseWheel="CurrentTimeText_MouseWheel"
                     BorderThickness="1,1,2,1" />
            <TextBox Name="CurrentLrcText"
                     Grid.Column="2"
                     Padding="4,0,0,0"
                     GotFocus="CurrentLrcText_GotFocus"
                     TextChanged="CurrentLrc_Changed"
                     BorderThickness="0,1,1,1" />
        </DockPanel>

    </Grid>
</UserControl>
